# =============================================================
# NG TRAVELS ERP - ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================

# Server Port
PORT=5000

# Node Environment (development | production)
NODE_ENV=production

# Production Database (PostgreSQL Connection String)
# Example: postgresql://username:password@your-db-host.com:5432/ngtravels?sslmode=require
DATABASE_URL=

# Geocoding, Places Autocomplete & Routing API Key (Geoapify or Google Maps)
GEOAPIFY_API_KEY=

# Production HTTPS Backend Endpoint (used by Owner APK, Driver APK & Web build)
VITE_API_URL=https://api.ngtravels.in

# Web Base Path
BASE_URL=/


