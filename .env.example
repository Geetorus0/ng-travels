# =============================================================
# NG TRAVELS ERP - ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================

# Server Port
PORT=5000

# Node Environment (development | production)
NODE_ENV=production

# Production Database — Supabase Postgres Connection String
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=

# Server-Only Supabase URL (used to verify Supabase Auth tokens and call the admin API)
SUPABASE_URL=https://nihoyzdepvqkypvwpvvy.supabase.co

# Geocoding, Places Autocomplete & Routing API Key (Geoapify or Google Maps)
GEOAPIFY_API_KEY=

# Production HTTPS Backend Endpoint (used by Owner APK, Driver APK & Web build)
VITE_API_URL=https://api.ngtravels.in

# Production Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://nihoyzdepvqkypvwpvvy.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=https://nihoyzdepvqkypvwpvvy.supabase.co
VITE_SUPABASE_ANON_KEY=

# Server-Only Supabase Key (Never expose to client or prefix with NEXT_PUBLIC/VITE)
SUPABASE_SERVICE_ROLE_KEY=


# Web Base Path
BASE_URL=/
