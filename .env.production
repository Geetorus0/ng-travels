# Overrides applied on top of .env when building in production mode
# (`vite build`, used for the Vercel deploy and for packaging the Capacitor APKs).
# On Vercel itself these are ignored in favor of the Project Settings env vars.
NODE_ENV=production
# Node Environment (development | production)
NODE_ENV=development
# Production HTTPS Backend Endpoint (used by Owner APK, Driver APK)
VITE_API_URL=https://api.ngtravels.in

# Server Port
PORT=5000

# Database — Supabase Postgres Connection String
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:Geetorus$123@db.nihoyzdepvqkypvwpvvy.supabase.co:5432/postgres

# Server-Only Supabase URL (used to verify Supabase Auth tokens and call the admin API)
SUPABASE_URL=https://nihoyzdepvqkypvwpvvy.supabase.co

# Server-Only Supabase Key (Never expose to client or prefix with NEXT_PUBLIC/VITE)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5paG95emRlcHZxa3lwdndwdnZ5Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4MTY2OTYzNiwiZXhwIjoyMDk3MjQ1NjM2fQ.3LRa_kZltrNUvRxokWo5UM4zQPNM_DAP1lHnf3WftUc

# Geocoding, Places Autocomplete & Routing API Key (Geoapify or Google Maps) — used by both apps
GEOAPIFY_API_KEY=fccc330705934d6abd2be56e77dff380

VITE_API_URL=http://localhost:5000

# Supabase (client-side)
NEXT_PUBLIC_SUPABASE_URL=https://nihoyzdepvqkypvwpvvy.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_1GqvzV0hVIPvrNWP0EUIaA_2ESDqj8X
